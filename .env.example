# ================================
# Database Configuration
# ================================

# MySQL JDBC URL
# 예시: jdbc:mysql://localhost:3306/umc10th?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_URL=jdbc:mysql://localhost:3306/{데이터베이스명}?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# MySQL 유저 이름
DB_USER=root

# MySQL 비밀번호
DB_PW=your_password_here

# ================================
# JWT Configuration
# ================================
# HS256 기준 최소 32바이트 이상 권장 (Base64 인코딩 문자열 가능)
# 예시: openssl rand -base64 32
JWT_SECRET_KEY=your_jwt_secret_key_here

# ================================
# Kakao OAuth
# ================================
# 카카오 디벨로퍼스(https://developers.kakao.com) > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=your_kakao_rest_api_key_here

# 카카오 디벨로퍼스 > 내 애플리케이션 > 보안 > Client Secret (활성화 후 발급)
KAKAO_CLIENT_SECRET=your_kakao_client_secret_here

# 카카오 디벨로퍼스 > 카카오 로그인 > Redirect URI 에 등록한 값과 정확히 일치해야 함
# 예시: http://localhost:8080/api/auth/oauth/kakao/callback
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/oauth/kakao/callback
